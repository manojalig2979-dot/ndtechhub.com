<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Redirect /index.html and /index to root /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*)index(\.html)?(\?|\ ) [NC]
    RewriteRule ^(.*)index(\.html)?$ /%1 [R=301,L]

    # 2. Redirect any request with .html extension to clean URL (e.g. /about.html -> /about)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.html [NC]
    RewriteRule ^ %1 [R=301,L]

    # 3. If file exists without .html, internally serve the .html file
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>
