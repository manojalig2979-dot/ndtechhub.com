rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'manoj.alig2979@gmail.com',
          'connect@ndtechhub.com',
          'hello@ndtechhub.com'
        ];
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
